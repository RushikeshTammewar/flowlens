# Flowlens replay worker env (Phase 3)

# Bearer token shared with apps/web. The TS replay-engine signs requests with this.
# Generate with `openssl rand -hex 32`. Mount via AWS Secrets Manager / Azure Key Vault.
REPLAY_WORKER_SHARED_SECRET=

# OpenAI key for the agent LLM + judge. Mount the same key apps/web uses.
OPENAI_API_KEY=

# Per-stage model overrides — same names as @flowlens/llm-config in TS.
# All optional; defaults apply if unset.
# FLOWLENS_MODEL_REPLAY_AGENT=gpt-4.1-mini
# FLOWLENS_MODEL_JUDGE=gpt-4.1-mini

# Browser Use Cloud (read by browser-use itself when it talks to BU Cloud).
BROWSER_USE_API_KEY=

# Logging
LOG_LEVEL=info
