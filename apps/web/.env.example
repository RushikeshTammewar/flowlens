# Flowlens v3 web env

# ─── Postgres (Neon, set via Vercel Marketplace integration) ────────────────
DATABASE_URL=postgres://user:pass@host:5432/flowlens?sslmode=require

# ─── Browser Use Cloud (https://cloud.browser-use.com/new-api-key) ──────────
BROWSER_USE_API_KEY=

# ─── Clerk (https://dashboard.clerk.com) ────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Webhook signing secret from Clerk dashboard → Webhooks → Add endpoint
# pointing to https://flowlens.in/api/webhooks/clerk (or http://localhost:3000
# tunneled via ngrok for local dev).
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/extension-callback
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/extension-callback

# ─── Vercel Blob (auto-provisioned by Vercel Marketplace integration) ───────
BLOB_READ_WRITE_TOKEN=
# Public base URL for blobs — copy from Vercel Blob dashboard.
# Format: https://<store-id>.public.blob.vercel-storage.com
BLOB_PUBLIC_BASE_URL=

# ─── OpenAI (only LLM provider used by v3) ──────────────────────────────────
OPENAI_API_KEY=

# Per-stage model overrides. All default to sensible OpenAI choices in
# apps/web/src/lib/models.ts; set these to override per environment.
# FLOWLENS_MODEL_NARRATE=gpt-4.1-mini       # vision narration of recorded steps
# FLOWLENS_MODEL_SYNTHESIZE=gpt-4.1         # whole-flow synthesis
# FLOWLENS_MODEL_REPLAY_AGENT=gpt-4.1-mini  # browser-use Agent loop
# FLOWLENS_MODEL_JUDGE=gpt-4.1-mini         # T3 yes/no judge
# FLOWLENS_MODEL_INVESTIGATOR=o4-mini       # failure root-cause classification
# FLOWLENS_MODEL_SITE_MODEL=gpt-4.1         # one-shot site understanding
# FLOWLENS_MODEL_DATA_GEN=gpt-4.1-mini      # per-step test data generator
# FLOWLENS_MODEL_SIBLING_GEN=gpt-4.1-mini   # sibling-flow suggester
# FLOWLENS_MODEL_DRIFT=gpt-4.1              # cross-run drift analyzer
# FLOWLENS_MODEL_SENSITIVE=gpt-4.1-mini     # sensitive-field classifier fallback

# ─── Cookie vault ───────────────────────────────────────────────────────────
# 64-byte hex; signs per-org cookie keypairs. Generate with:
#   openssl rand -hex 64
FLOWLENS_VAULT_SECRET=

# ─── Replay worker (Python sidecar; Phase 3) ────────────────────────────────
# Public URL of the deployed apps/replay-worker (AWS App Runner or Azure
# Container Apps — see apps/replay-worker/deploy/README.md).
REPLAY_WORKER_URL=
# Bearer token shared with the worker. Generate with `openssl rand -hex 32`.
REPLAY_WORKER_SHARED_SECRET=

# ─── Upstash Redis (SSE event log + per-org concurrency) ────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Legacy (v2 only — not used by v3) ──────────────────────────────────────
# GEMINI_API_KEY=     # (legacy v2 — not used by v3)
# GEMINI_MODEL=       # (legacy v2 — not used by v3)
# GOOGLE_API_KEY=     # (legacy v2 — not used by v3)
