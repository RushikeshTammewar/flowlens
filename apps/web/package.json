    "@flowlens/flow-doc": "workspace:*",
    "@flowlens/llm-config": "workspace:*",
    "@flowlens/replay-engine": "workspace:*",
    "@flowlens/schema": "workspace:*",
    "@upstash/redis": "^1.34.4",
    "@workflow/next": "^4.0.5",
    "workflow": "^4.2.4",
    "@vercel/blob": "^0.27.3",
    "drizzle-orm": "^0.39.3",
    "next": "16.1.6",
    "openai": "^6.34.0",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svix": "^1.45.1",
    "zod": "^3.25.0"
