{
  "name": "@flowlens/web",
  "version": "0.0.0",
  "description": "Flowlens v3 web dashboard + API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start",
