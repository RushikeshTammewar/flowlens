{
  "name": "@flowlens/extension",
  "version": "0.0.0",
  "description": "Flowlens v3 Chrome extension — record, replay, refresh auth",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "wxt prepare && tsc --noEmit",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "echo 'lint OK'",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@flowlens/design-tokens": "workspace:*",
    "@flowlens/recorder-core": "workspace:*",
    "@flowlens/schema": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rrweb": "^2.0.0-alpha.18",
    "zustand": "^5.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.299",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "wxt": "^0.20.6"
  }
}
